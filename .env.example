# Copy this file to .env and fill values before running in development
# Do NOT commit your real .env with secrets to the repository.

# Flask / App
FLASK_ENV=production
SECRET_KEY=replace-this-with-a-secure-random-value

# Database (example for Postgres)
#DATABASE_URL=postgresql://user:password@host:5432/dbname

# Mail (required for password reset / welcome emails)
# Gmail: use an App Password (not your normal Gmail password).
#   1) Google Account → Security → 2-Step Verification (on)
#   2) App passwords → Mail → generate → paste 16-char password as MAIL_PASSWORD
#MAIL_SERVER=smtp.gmail.com
#MAIL_PORT=587
#MAIL_USE_TLS=true
#MAIL_USERNAME=tradeversesupport@gmail.com
#MAIL_PASSWORD=xxxx xxxx xxxx xxxx
#MAIL_DEFAULT_SENDER=TradeVerse <tradeversesupport@gmail.com>
#PUBLIC_SITE_URL=https://www.tradeversejournal.space

# Optional: Discord invite URL for footer & landing. Leave unset to use the default invite.
# Set to empty to hide Community links: DISCORD_COMMUNITY_URL=
#DISCORD_COMMUNITY_URL=https://discord.gg/avZdspg2H

# AI Buddy — optional web coach (OpenAI). Tavily improves general-market answers only.
#FEATURE_AI_WEB=true
#OPENAI_API_KEY=
#TAVILY_API_KEY=

# Market data (navbar quotes + Strategy Lab daily backtests)
# Optional: Twelve Data free/paid key. Without it, Lab uses Yahoo Finance daily OHLC (free).
#TWELVEDATA_API_KEY=

# Other service credentials (Stripe, Flutterwave, Paytiko, AWS, etc.)
#STRIPE_SECRET_KEY=
#STRIPE_PRICE_PRO=
#STRIPE_PRICE_PRO_PLUS=
#STRIPE_WEBHOOK_SECRET=
#FLW_SECRET_KEY=
#FLW_PUBLIC_KEY=
#FLW_CURRENCY=USD

# Signup abuse / email quality
# Max new accounts per IP per window (default 4 / hour)
#TV_REGISTER_MAX_PER_IP_HOUR=4
#TV_REGISTER_IP_WINDOW_SECONDS=3600
# Comma-separated extra blocked email domains
#TV_EXTRA_BLOCKED_EMAIL_DOMAINS=
# NEVER enable on production — only for local automated tests that use @example.com
#TV_ALLOW_TEST_EMAIL_DOMAINS=0
# Max accounts sharing the same full name (default 2)
#TV_MAX_ACCOUNTS_PER_DISPLAY_NAME=2
# Password reset link lifetime (seconds, default 1 hour)
#TV_PASSWORD_RESET_MAX_AGE=3600
#TV_PASSWORD_RESET_MAX_PER_IP_HOUR=8
# Public site URL for links inside recovery emails (recommended on Render)
#PUBLIC_SITE_URL=https://www.tradeversejournal.space

# Trials / promo (Pro Plus) — current + new users
# New signups: days of Pro Plus trial at registration (default 60)
#TV_TRIAL_DAYS_PRO_PLUS=60
# All-users marketing trial: repair/grant Pro Plus while personal trial_ends_at is future
# (auto-repaired on login/request; CLI: flask grant-promo-trial --days 60)
#TV_ALL_USERS_PROPLUS_TRIAL=1
#TV_ALL_USERS_PROPLUS_TRIAL_DAYS=60
# Optional global feature unlock after personal trial ends (ISO date/datetime)
#TV_PROMO_ACCESS_UNTIL=
# Hard end date so everyone (including expired trials) stays Pro Plus until then
#TV_PROMO_ACCESS_UNTIL=2026-09-15
# On Render boot: one-time flask grant-promo-trial (marker on persistent disk)
#TV_GRANT_PROMO_ON_START=1
# Manual grant:
#   flask grant-promo-trial --days 60

# =============================================================================
# Persistent user media (avatars, planner before/after, playbook, replay, OHLC)
# Without one of these backends, Render wipes uploads on every redeploy (~days).
# =============================================================================
#
# OPTION A (preferred): S3-compatible object storage — AWS S3 or Cloudflare R2
#S3_BUCKET=your-bucket-name
# Alias also accepted: AWS_S3_BUCKET= / R2_BUCKET=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_REGION=auto
# Cloudflare R2 endpoint (required for R2; omit for AWS S3):
#S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Optional public/CDN base (if bucket objects are publicly readable):
#S3_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# Optional key prefix inside the bucket:
#S3_PREFIX=tradeverse
#
# OPTION B: Render persistent disk (no cloud bucket)
# Dashboard → Disks → add disk mounted at /var/data, then:
#TRADEVERSE_DATA_DIR=/var/data
# Aliases: UPLOAD_ROOT= / PERSISTENT_DISK_PATH=
# If /var/data is set but not mounted, the app falls back to app/static (EPHEMERAL).
# Local default: app/static/uploads/...
